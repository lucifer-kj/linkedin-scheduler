datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  sessionId       String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  linkedinAccount LinkedinAccount?
  oauthCredential OAuthCredential?
  posts           Post[]
  oauthStates     OAuthState[]
}

model OAuthCredential {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedClientId     String
  clientIdIv            String
  clientIdAuthTag       String
  encryptedClientSecret String
  clientSecretIv        String
  clientSecretAuthTag   String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OAuthState {
  state     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model LinkedinAccount {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedinPersonUrn    String
  linkedinName         String   @default("LinkedIn User")
  encryptedAccessToken String
  tokenIv              String
  tokenAuthTag         String
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  posts                Post[]
}

model Post {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedinAccountId String?
  linkedinAccount   LinkedinAccount? @relation(fields: [linkedinAccountId], references: [id], onDelete: SetNull)
  content           String
  scheduledFor      DateTime
  status            String           @default("scheduled")
  idempotencyKey    String           @unique
  bullmqJobId       String?
  retryCount        Int              @default(0)
  maxRetries        Int              @default(5)
  lastError         String?
  externalPostUrn   String?
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
}
