# Application Configuration
PORT=3000
NODE_ENV=development

# Database (SQLite for immediate local zero-config testing; PostgreSQL for production/Docker)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL for Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkedin_scheduler?schema=public"

# Redis Queue (Optional locally; BullMQ uses Redis when provided, falls back to atomic DB scheduler if absent)
REDIS_URL="redis://localhost:6379"

# 256-bit Hex Key for AES-256-GCM Token Encryption (64 hex characters)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# LinkedIn OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID="mock_client_id"
LINKEDIN_CLIENT_SECRET="mock_client_secret"
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"

# Evaluator Mock Mode: Set to "true" to test the entire lifecycle without LinkedIn app approval
USE_MOCK_LINKEDIN="true"

# Evaluator Test Injection: Simulate transient 503 errors on attempt 1 to demonstrate automatic retry
SIMULATE_TRANSIENT_FAILURE="false"
