{
  "name": "linkedin-scheduler",
  "version": "1.0.0",
  "description": "Production-grade LinkedIn Post Scheduler with OAuth 2.0, AES-256-GCM token encryption, BullMQ queue, and exponential backoff retry mechanism.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && pnpm --filter web build && node -e \"import('node:fs').then(fs => fs.cpSync('web/out', 'dist/public', { recursive: true }))\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/deployment-debugger.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.6.3",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/serve-static": "^12.1.1",
    "@prisma/client": "5.22.0",
    "@types/cookie-parser": "^1.4.10",
    "bullmq": "^6.7.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "ioredis": "^6.1.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.3",
    "@swc/core": "^1.16.22",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/supertest": "^7.2.1",
    "prisma": "5.22.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
